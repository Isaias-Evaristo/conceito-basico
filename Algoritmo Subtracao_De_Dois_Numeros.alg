Algoritmo "Subtracao_De_Dois_Numeros"


Var

   N1, N2, Subtracao: Real
   
   
Inicio

   Escreval("Digite um número!")
   leia(N1)
   Escreval("Digite um segundo número!")
   leia(N2)
   
   Subtracao <- N1 - N2
   
   Escreval("A subtração é: ", Subtracao)
   
   
Fimalgoritmo
