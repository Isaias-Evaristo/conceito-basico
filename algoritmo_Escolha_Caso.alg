 algoritmo "EscolhaCaso"

   var

   Opcao: inteiro

  inicio

      Escreval("1 - Guerreiro, 2 - Mago, 3 - Arqueiro")
      leia(Opcao)

      escolha Opcao

      caso 1
      escreval("Personagem Guerreiro...")

      caso 2
      escreval("Personagem Mago...")

      caso 3
      escreval("Personagem Arqueiro...")

      fimescolha

  fimalgoritmo