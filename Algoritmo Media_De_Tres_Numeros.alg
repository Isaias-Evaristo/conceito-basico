Algoritmo "Media_De_Tres_Numeros"


Var

  N1, N2, N3, Media: Real
  
  
Inicio

  Escreval("Digite um número!")
  leia(N1)
  Escreval("Digite um segundo número!")
  leia(N2)
  Escreval("Digite um terceiro número!")
  leia(N3)
  
  Media <- (N1 + N2 + N3)/ 3
  
  
  Escreval("A média da soma dos três números dividido por três é: ", Media)
  
  
Fimalgoritmo