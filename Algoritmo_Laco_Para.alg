Algoritmo "Laço_Para"


Var

  Contador: Inteiro

  Nome: Caractere
  
  
Inicio

    Para Contador de 1 Ate 3 faca
    
    Escreval("Digite seu nome!")
    leia(Nome)
    
    Escreval("Nome Informado: ", Nome)

    Escreval("------------------")
    
    Fimpara
    
Fimalgoritmo