Algoritmo "Calculo_De_Area_De_Um_Retangulo"

Var

   Altura: Real

   Base: Real

   Area: Real

Inicio

    Escreval("Qual é a base de um retângulo?")
    leia(Base)

    Escreval("Qual é a altura da base do retângulo?")
    leia(Altura)

    Area <- Base * Altura

    Escreval("O calculo da Àrea de um retângulo é: ", Area)

Fimalgoritmo 

