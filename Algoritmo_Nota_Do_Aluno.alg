Algoritmo "Nota_Do_Aluno"


Var

  Nota: Real
  
Inicio

   Escreval("Digite sua nota!")
     leia(Nota)
     
     
   Se (Nota < 5)Entao
   Escreval("Insuficiente!")
   senao
   
   Se (Nota >= 5) e (Nota < 7) Entao
   Escreval("Regular!")
   senao

   Se Nota >= 7 Entao
   Escreval("Bom!")
   Fimse
  Fimse
 Fimse
Fimalgoritmo