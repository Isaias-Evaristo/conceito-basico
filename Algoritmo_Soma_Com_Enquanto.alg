Algoritmo "Soma_Com_Enquanto"


Var

   Contador: Inteiro
   Acumulador: Inteiro
   
Inicio

   Contador <- 1
   Acumulador <- 0

   Enquanto (Contador <= 5) Faca
      Acumulador <- Acumulador + Contador
      Contador <- Contador + 1
      
   FimEnquanto

   Escreval("A soma é: ", Acumulador)
   
Fimalgoritmo