correto? : Algoritmo "Calculadora_De_Media"

Var

 N1, N2, N3, Media: Real

Inicio

   Escreval("Digite a nota da primeira prova!")
   leia(N1)
   Escreval("Digite a nota da segunda prova!")
   leia(N2)
   Escreval("Digite a nota da terceira prova!")
   leia(N3)

   Media <- (N1 + N2 + N3)/3

   Escreval("A media das três notas é: ", Media)

Fimalgoritmo

