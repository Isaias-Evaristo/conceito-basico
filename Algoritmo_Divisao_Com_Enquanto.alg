Algoritmo "A_Divisao_Com_Enquanto"


Var

  Contador: Inteiro
  
  Acumulador: Real
  
Inicio

     Contador <- 1
     Acumulador <- 1
     
     Enquanto ( Contador <= 5) faca
     Acumulador <- Acumulador / Contador
     
     Contador <- Contador +1
     
     Fimenquanto
     
Escreval("A divisão é: ", Acumulador)

Fimalgoritmo