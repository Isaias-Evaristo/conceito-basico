Algoritmo "Multiplicacao_De_Dois_Numeros"


Var

  N1, N2, Multiplicacao: Real
  
  
  
Inicio

   Escreval("Digite um número!")
   leia(N1)
   Escreval("Digite um segundo número!")
   leia(N2)
   
   Multiplicacao <- N1 * N2
   
   Escreval("A multiplicação de dois números é: ", Multiplicacao)
   
   
Fimalgoritmo