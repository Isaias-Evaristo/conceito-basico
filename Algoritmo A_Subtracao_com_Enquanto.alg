Algoritmo "A_Subtracao_com_Enquanto"


Var

  Contador: Inteiro
  
  Acumulador: Inteiro
  
Inicio

    Contador <- 1
    Acumulador <- 0
    
    Enquanto ( Contador <= 5) faca
    Acumulador <- Acumulador - Contador
    
    Contador <- Contador + 1
    
    Fimenquanto
    
    Escreval("A subtração é: ", Acumulador)
    
Fimalgoritmo